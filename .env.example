# Create a bot via @BotFather and paste its token here.
BOT_TOKEN=your_telegram_bot_token

# Your personal numeric Telegram ID. The bot will ignore everyone else.
ADMIN_ID=123456789

# Create an API key at https://openrouter.ai/keys. Keep it secret.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# Used after photo receipt recognition is added.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Used only for explicitly complex analysis or as a controlled fallback.
OPENROUTER_ADVANCED_MODEL=anthropic/claude-sonnet-4.5
AI_DAILY_LIMIT_USD=1.00
AI_MONTHLY_LIMIT_USD=15.00

# Set this to a folder synchronized by the Yandex Disk desktop app.
# Example: BACKUP_DIR=C:\Users\YourName\YandexDisk\ApexCRM-backups
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
ARCHIVE_RETENTION_DAYS=30

# At 23:50 Moscow time remove routine dialogue from the private Telegram chat
# and optional comma-separated group chats. The bot needs permission to delete
# messages in every configured group. Saved order/appointment cards and photos remain.
CHAT_CLEANUP_ENABLED=true
CHAT_CLEANUP_HOUR=23
CHAT_CLEANUP_CHAT_IDS=-1001234567890

# PWA credentials. Generate the password hash and session secret during deployment.
PWA_ADMIN_USER=admin
PWA_PASSWORD_HASH=pbkdf2_sha256$iterations$salt$digest
PWA_SESSION_SECRET=replace_with_at_least_32_random_characters
PWA_COOKIE_SECURE=true
