[Unit]
Description=Apex Auto CRM PWA
Wants=network-online.target
After=network-online.target apex-crm-bot.service

[Service]
Type=simple
User=apexcrm
Group=apexcrm
WorkingDirectory=/opt/apex-crm/current
EnvironmentFile=/opt/apex-crm/shared/.env
ExecStart=/opt/apex-crm/current/.venv/bin/uvicorn pwa:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apex-crm/shared

[Install]
WantedBy=multi-user.target
